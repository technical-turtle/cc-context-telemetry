#!/bin/sh
# cc-context-telemetry - statusLine entry (the SAFE wrapper). PURE POSIX SHELL.
#
# Claude Code runs this as its statusLine command, with the session JSON on stdin,
# EVERY render. The hot path here is therefore deliberately Node-free: spawning a
# Node process per render (tens of MB, ~100ms) across many concurrent sessions at
# high render frequency piles up load and can take a machine down. So this entry
# does only the minimum, in shell:
#   1. read stdin ONCE into a temp file,
#   2. extract session_id with a bounded sed (fall back to "default"),
#   3. write the RAW payload to telemetry-raw-<session_id>.json (the ONLY write;
#      all JSON parsing happens later, on demand, in the hook/consumer via index.js),
#   4a. WRAP mode (env CCT_WRAP set): EXEC the wrapped command on the SAME stdin so
#       THIS process BECOMES your statusline and Claude Code manages it exactly like
#       a direct statusLine (no spawn, no detach, no babysat orphan), or
#   4b. STANDALONE mode (no CCT_WRAP): print a minimal plain-text bar extracted from
#       the payload in shell (no emoji), then exit 0. Never blank.
#
# WHY EXEC, NOT SPAWN: Claude Code kills the statusline process every render to keep
# it bounded. EXEC makes the wrapped command BE the process Claude Code kills, so it
# is torn down each render exactly as if run directly. No pile-up, no orphan.
set -u

# Capture stdin to a temp file ONCE so both the raw-telemetry write and the EXEC'd
# statusline get the EXACT same bytes.
#
# WHY `cat` CANNOT HANG HERE (evidence, not assumption): a `cat` reading the statusLine
# stdin only blocks if Claude Code never closes that stdin. We have direct evidence it
# DOES close it: the `adtention` statusLine binary's `status` command does
# `io.ReadAll(os.Stdin)`, which blocks until EOF, and it runs FLAT as a DIRECT
# statusLine on every render with no pile-up (owner-confirmed in production). If Claude
# Code did NOT close the statusLine's stdin, that direct `io.ReadAll` would hang EVERY
# render and the renders would pile up - they do not - therefore Claude Code closes the
# statusLine's stdin after its single bounded write. Our `cat` reads the IDENTICAL stdin
# Claude Code hands the statusLine (the wrapper IS the statusLine via exec), so it gets
# the IDENTICAL EOF and returns. We deliberately do NOT add a per-render read timeout or
# a Node guard: that would reintroduce a per-render spawn (the exact pile-up this rewrite
# removes), to "fix" a hang the evidence above shows cannot happen. The test harness
# feeds a closing stdin to exercise this real EOF path.
tmp="$(mktemp 2>/dev/null)" || tmp="${TMPDIR:-/tmp}/cct.$$"
cat > "$tmp"

# Telemetry dir: CCT_DIR override, else ~/.claude/cc-context-telemetry. Mirror
# index.js telemetryDir(). HOME may be unset in odd environments; tolerate it.
dir="${CCT_DIR:-${HOME:-/tmp}/.claude/cc-context-telemetry}"

# Extract the TOP-LEVEL "session_id" string in pure shell. Bounded: a single
# non-greedy sed over one line of the (small) payload. Sanitize to [A-Za-z0-9_-] so a
# hostile id cannot escape the dir, then mirror index.js sanitizeId so a reader
# resolves the same filename: every char outside [A-Za-z0-9_-] becomes "_", and an
# empty result falls back to "default" (NOT "shared" - the JS reader's empty-id
# fallback is "default"; they must agree or a hook read would miss the file). For a
# real session_id (an ASCII UUID: hex + hyphens) shell `tr` (byte-wise) and JS regex
# (code-unit) agree EXACTLY. An exotic non-ASCII id may map to a different name in the
# two (tr counts bytes, JS counts UTF-16 units), but BOTH stay contained inside the
# dir - the worst case is a fail-safe read-miss, never a path escape.
sid="$(sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$tmp" 2>/dev/null | head -n 1)"
sid="$(printf '%s' "$sid" | tr -c 'A-Za-z0-9_-' '_' )"
[ -n "$sid" ] || sid="default"

# Write the RAW payload for on-demand parsing by the consumer. Per session, so the
# file count is bounded by live sessions (the reader prunes stale ones, see
# index.js). Best-effort: a failed mkdir/write must never break the bar.
#
# ATOMIC: write to a temp file IN THE SAME DIR, then `mv` (rename) over the final
# name. POSIX rename within a filesystem is atomic, so a concurrent on-demand reader
# sees either the old complete file or the new complete file, never a half-written
# one. (cp alone writes in place and a reader could catch a partial file; the reader
# tolerates that by returning null on a parse error, but the atomic rename removes
# the race entirely.) The temp uses $$ so concurrent renders for the SAME session do
# not clobber each other's temp; the final rename is last-writer-wins, which is
# correct (newest render's payload wins).
mkdir -p "$dir" 2>/dev/null || true
raw_final="$dir/telemetry-raw-$sid.json"
raw_tmp="$dir/.telemetry-raw-$sid.$$.tmp"
if cp "$tmp" "$raw_tmp" 2>/dev/null; then
  mv -f "$raw_tmp" "$raw_final" 2>/dev/null || rm -f "$raw_tmp" 2>/dev/null || true
fi

# Build the telemetry SEGMENT: "ctx X% | 5h Y% ~cd | 7d Z% ~cd" in cheap pure shell.
# Shown PREPENDED in WRAP mode and as the whole bar in STANDALONE. No emoji (project rule).
# Never blank. Cosmetic and fail-soft; the AUTHORITATIVE parse is index.js (real JSON.parse).
#
# ctx (context %) and the model token are PER SESSION: they come only from THIS render's
# payload ($tmp).
#
# 5h/7d are ACCOUNT-WIDE. Claude Code refreshes rate_limits only when a session makes an API
# call, so different open sessions disagree: a session that has not called recently keeps
# reporting its OLD reading. Each session therefore keeps a tracker (telemetry-rl2-<sid>) that
# records, per window, WHEN its reading was measured, and the picker (see consider()) takes, per
# window, among readings whose reset is still in the FUTURE:
#   (resets_at DESC, then measurement time DESC)
# i.e. the newest window, and in it the most recently measured reading. Usage percentages are
# never compared: after a quota reset the newest reading is the LOWER one and it must win, and
# within a window the most recent reading is right whatever its number. (Earlier versions
# ranked by usage or dated readings by the 5h window; both showed stale numbers after a
# mid-window reset, on 2026-09-05 and again on plans without a 5-hour limit.)
#
# The measurement time:
#   - For a session this script has seen before: the moment its reading CHANGED. A reading
#     changes only when an API response refreshes it (including responses to the session
#     subagents), so the change moment is when it was measured, and an idle session keeps its
#     old stamp. An unchanged reading keeps its stamp even if a request was made (a cancelled
#     request returns no new numbers). A session is never handed an old value as a change:
#     live data shows a resumed session carries no rate_limits until its first request, and a
#     new session carrying its process cached numbers is a first sighting (below).
#   - A session that renders BEFORE its first request (older Claude Code shows no rate_limits
#     then) gets an empty marker tracker, so its first reading is a change, stamped when it
#     appears: a fresh measurement.
#   - For a FIRST sighting (no tracker yet: a fresh install, a session idle since before its
#     tracker existed, a recreated tracker), the change moment is unknown. Newer Claude Code
#     (2.1.280+) exposes the session last main-thread API request as prompt_cache.expires_at and
#     .ttl (each request refreshes the cache, so expires_at - ttl is when it was sent): that is
#     the stamp, so an idle session carries its real, old time. Verified on the live pool
#     (2026-11-01): in all 34 payloads that carry it, it is never later than the render that
#     showed it, and idle sessions carry times hours to days old. Older Claude Code has no
#     prompt_cache: then the time of the last assistant entry in the tail of the session
#     transcript (transcript_path) is the stamp, read once on the first sighting only. Without
#     either (no request yet, no transcript) the time is UNKNOWN and the stamp is 0, so the
#     reading ranks below every reading with a known time until it changes.
#   - A stored stamp that is not a plain number, has 12+ digits, or lies more than 60s in the
#     future (a corrupt tracker, a clock step) is treated as a first sighting and replaced.
#   - So a reading is stamped "now" only when this session just measured it: never on a first
#     sighting, never for a value received without a request, and a deleted tracker cannot make
#     an old reading look new. The reader prune (index.js) still keeps a tracker until every
#     reset boundary in it has elapsed, and a reading whose boundary elapsed is excluded here,
#     so an ancient payload cannot win.
# All stamps come from this machine clock. On the live pool (2026-11-01, 150 trackers over 17
# weekly windows), ordered by stamp, 7d usage only went DOWN at the 2026-09-05 reset (correct,
# the newer reading) and at one re-rendered ancient payload whose window had already elapsed
# (excluded).
#
# A stamp more than 60s in the future (corrupt tracker, clock jump) drops the entry from the
# pick, and the owning session heals it on its next render (see PHASE 2).
#
# now comes from CCT_NOW when set (a deterministic test seam, unused in production) else
# `date +%s`; countdown is a pure DURATION so no timezone math. now must be valid for the
# change tracker to stamp a TS and for the account-wide picker to run.
now="${CCT_NOW:-$(date +%s 2>/dev/null)}"
case "$now" in ""|*[!0-9]*) now="" ;; esac

# Which segments to show, and in what ORDER (CCT_SEGMENTS, comma or space separated).
# Tokens: ctx, 5h, 7d, model. Order = display order; presence = shown. Unknown tokens are
# ignored; unset or empty falls back to the default. This is the only knob for the layout.
segs="${CCT_SEGMENTS:-ctx,5h,7d,model}"

# PHASE 1: extract THIS render's rate_limit reading as "5U|5R|7U|7R|LC" (raw used_percentage +
# reset epoch for five_hour|seven_day, empty string for an absent field, then LC = the epoch of
# this session last API request when the payload exposes it, else empty), reusing the SAME
# objspan/up/resetsat parse the segment awk uses. One awk over just this payload.
cur="$(LC_ALL=C awk '
  function objspan(key,   p, i, n, depth, start, c, off) {
    # Find the first occurrence of the quoted key that IS a key (followed, after JSON whitespace,
    # by a colon), skipping the same text used as a string VALUE (e.g. a session name). Then the
    # value must BE an object: a null, number or string value (e.g. "five_hour": null) returns ""
    # instead of scanning ahead into the NEXT object and reading the fields of a sibling as its
    # own. Whitespace is space, tab and CR (LF never reaches J: awk joins the records without it),
    # so CRLF or pretty-printed payloads parse; up(), resetsat() and modelid() allow the same.
    n = length(J); off = 0
    while (1) {
      p = index(substr(J, off + 1), "\"" key "\"")
      if (p == 0) return ""
      p += off; i = p + length(key) + 2
      while (i <= n && index(" \t\r", substr(J, i, 1)) > 0) i++
      if (i <= n && substr(J, i, 1) == ":") break
      off = p
    }
    i++
    while (i <= n && index(" \t\r", substr(J, i, 1)) > 0) i++
    if (i > n || substr(J, i, 1) != "{") return ""
    start = i; depth = 0
    while (i <= n) {
      c = substr(J, i, 1)
      if (c == "{") depth++
      else if (c == "}") { depth--; if (depth == 0) return substr(J, start + 1, i - start - 1) }
      i++
    }
    return ""
  }
  function up(key,   t) {
    t = objspan(key)
    if (t == "") return ""
    gsub(/\{[^{}]*\}/, "", t)
    if (match(t, /"used_percentage"[ \t\r]*:[ \t\r]*[0-9]+(\.[0-9]+)?/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*:[ \t\r]*/, "", t); return t
  }
  function resetsat(key,   t) {
    t = objspan(key)
    if (t == "") return ""
    gsub(/\{[^{}]*\}/, "", t)
    if (match(t, /"resets_at"[ \t\r]*:[ \t\r]*[0-9]+/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*:[ \t\r]*/, "", t); return t
  }
  { J = J $0 }
  # The time of this session last API request, from prompt_cache (Claude Code 2.1.280+): each
  # request refreshes the prompt cache, so expires_at - ttl is when the last request was made,
  # i.e. when the rate_limits in this payload were measured. "" when the block, either field,
  # or a sane value is missing (older Claude Code, or no request yet).
  function lastcall(   t, e, d, n, u) {
    t = objspan("prompt_cache")
    if (t == "") return ""
    gsub(/\{[^{}]*\}/, "", t)
    if (match(t, /"expires_at"[ \t\r]*:[ \t\r]*[0-9]+/) == 0) return ""
    e = substr(t, RSTART, RLENGTH); sub(/.*:[ \t\r]*/, "", e)
    if (match(t, /"ttl"[ \t\r]*:[ \t\r]*"[0-9]+[smh]"/) == 0) return ""
    d = substr(t, RSTART, RLENGTH); sub(/.*:[ \t\r]*"/, "", d); sub(/"$/, "", d)
    u = substr(d, length(d), 1); n = substr(d, 1, length(d) - 1) + 0
    n = (u == "h") ? n * 3600 : (u == "m") ? n * 60 : n
    if (n <= 0 || e + 0 < 1000000000 || e + 0 >= 100000000000) return ""
    if (e - n < 1000000000) return ""
    return sprintf("%.0f", e - n)
  }
  END { printf "%s|%s|%s|%s|%s", up("five_hour"), resetsat("five_hour"), up("seven_day"), resetsat("seven_day"), lastcall() }
' "$tmp" 2>/dev/null)"

# PHASE 2: update THIS session's change tracker BEFORE the picker scans, so the current
# reading is represented. The tracker is a single line "TS5|5U|5R|TS7|7U|7R" with a SEPARATE
# measurement timestamp PER WINDOW: rate_limits change only on an API response, and the two
# windows can change independently, so each window keeps its OWN "last changed" stamp: TS5/TS7
# = now ONLY for the window whose reading actually differs from what we stored (a byte-identical
# window KEEPS its old TS); the untouched window's TS is preserved verbatim. A first sighting
# is stamped LC (the last-call time) when the payload has it, else the transcript time, else 0.
# The line is rewritten only when a value changes (or a stamp is healed), so an unchanged
# render writes nothing.
# A shared single TS was a bug: 5h churn would restamp the whole line and make a STALE 7d in
# that same line look freshest, letting it win the account-wide pick with a stale countdown.
# No rate_limits at all (cur == "|||") or an empty extraction: nothing to track. Requires a
# valid now. Atomic write (temp in the same dir + mv), the same pattern as the raw write; the
# "." prefix + $$ keeps concurrent renders from clobbering and keeps the temp out of the picker
# glob (no dotfiles).
# The tracker file is versioned (telemetry-rl2-*): earlier versions (telemetry-rl-*) stamped a
# first sighting "now" and could restamp an old reading after an age prune, so their stamps are
# not measurement times. 1.4.8 never reads them (a session is first-sighted afresh, with its
# real last-call time where Claude Code exposes it); the reader prune removes them.
rl_final="$dir/telemetry-rl2-$sid"
# Split off LC (the last field) first, so the window fields below are "5U|5R|7U|7R".
lc="${cur##*|}"; cur="${cur%|*}"
case "$lc" in ""|*[!0-9]*) lc="" ;; esac
# A call cannot have happened after now: a later LC (clock skew, a corrupt value) is not a
# measurement time and is dropped (the reading is then of unknown time, stamp 0).
if [ -n "$lc" ] && [ -n "$now" ] && [ "$lc" -gt "$now" ] 2>/dev/null; then lc=""; fi
case "$cur" in
  '') : ;;
  '|||')
    # No rate_limits in this render (older Claude Code before a session first request, or a
    # plan without them). If this session has no tracker yet, write an EMPTY marker line
    # "now|||now||": the session is then known, so its first rate_limits reading (which can only
    # appear after a request) is a CHANGE stamped when it appears, not an unknown first sighting.
    # A marker carries no reading, so the picker skips it and the reader prune ages it out.
    if [ -n "$now" ] && [ ! -e "$rl_final" ]; then
      rl_tmp="$dir/.telemetry-rl2-$sid.$$.tmp"
      if { printf '%s|||%s||' "$now" "$now" > "$rl_tmp"; } 2>/dev/null; then
        mv -f "$rl_tmp" "$rl_final" 2>/dev/null || rm -f "$rl_tmp" 2>/dev/null || true
      fi
    fi
    ;;
  *)
    # Something other than a regular file at the tracker path (a directory, a FIFO) is not ours
    # to write through: skip tracking for this session rather than rename temps into it.
    if [ -n "$now" ] && { [ ! -e "$rl_final" ] || [ -f "$rl_final" ]; }; then
      # Split THIS render's reading "5U|5R|7U|7R" into per-window pairs cur5="5U|5R" and
      # cur7="7U|7R" using pure parameter expansion (no extra process).
      cur_rest="${cur#*|}"; cur_5u="${cur%%|*}"; cur_5r="${cur_rest%%|*}"
      cur_7r="${cur##*|}"; cur_mid="${cur%|*}"; cur_7u="${cur_mid##*|}"
      cur5="$cur_5u|$cur_5r"; cur7="$cur_7u|$cur_7r"
      p1=""; p2=""; p3=""; p4=""; p5=""; p6=""; have=0
      if [ -f "$rl_final" ] && [ -r "$rl_final" ]; then
        have=1
        # Split the stored line on "|" into its 6 fields. `|| :` keeps the partial content on
        # a no-trailing-newline EOF (our writer emits no trailing newline). IFS is scoped to
        # this one `read` (a prefix assignment) so it does not leak.
        # Wrapped so that a tracker removed between the test above and this open (a concurrent
        # prune) cannot print the shell "cannot open" error: redirections apply left to right.
        { IFS='|' read -r p1 p2 p3 p4 p5 p6 < "$rl_final"; } 2>/dev/null || :
      fi
      prev5="$p2|$p3"; prev7="$p5|$p6"
      # Per-window TS = when that reading was MEASURED. A tracked session: the moment its pair
      # CHANGED (restamp only the window whose pair differs; keep the other's stored TS). This
      # sees every refresh, including ones from the session subagents, which do not move LC.
      # A FIRST sighting (no tracker yet): the change moment is unknown, so use LC, the time of
      # the session last API request, when the payload exposes it. Without it the measurement
      # time is UNKNOWN and the stamp is 0: such a reading ranks below every reading with a known
      # time (it can be old: an idle session, a new session carrying its process cached value)
      # and takes a real stamp at its next change.
      # Older Claude Code has no prompt_cache: on a first sighting (or a heal) only, never per
      # render, read the tail of the session transcript and take the time of its last top-level
      # assistant entry, the last API response written. Verified on the live pool (2026-11-01):
      # it matches a full JSON parse on every reachable transcript; where prompt_cache also
      # exists it lies within seconds after that request start (the entry is written when the
      # response has streamed), so it dates the reading as the request it came from did.
      # A stored stamp that is not a plain number, is longer than any epoch (12+ digits, beyond the
      # shell integer range), or lies beyond the picker future bound (now + 60) is not a
      # measurement time: that window is HEALED as if first sighted (below).
      o1="$p1"; o4="$p4"; heal1=0; heal4=0
      if [ "$have" -eq 1 ]; then
        case "$p1" in ""|*[!0-9]*|????????????*) heal1=1 ;; *) [ "$p1" -gt $((now + 60)) ] 2>/dev/null && heal1=1 ;; esac
        case "$p4" in ""|*[!0-9]*|????????????*) heal4=1 ;; *) [ "$p4" -gt $((now + 60)) ] 2>/dev/null && heal4=1 ;; esac
      fi
      first=0
      if [ -n "$lc" ]; then first="$lc"
      elif [ "$have" -eq 0 ] || [ "$heal1" -eq 1 ] || [ "$heal4" -eq 1 ]; then
        tp="$(sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' "$tmp" 2>/dev/null | head -n 1)"
        if [ -n "$tp" ] && [ -f "$tp" ] && [ -r "$tp" ]; then
          tx="$(tail -c 262144 "$tp" 2>/dev/null | LC_ALL=C awk '
            function lastval(s, key,   p, q, r) {
              r = ""
              while ((p = index(s, key)) > 0) {
                s = substr(s, p + length(key)); q = index(s, "\""); if (q > 0) r = substr(s, 1, q - 1)
              }
              return r
            }
            function epoch(iso,   y, mo, d, h, mi, se, yy, era, yoe, doy, doe) {
              if (iso !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/) return ""
              if (iso !~ /Z$/) return ""
              y = substr(iso, 1, 4) + 0; mo = substr(iso, 6, 2) + 0; d = substr(iso, 9, 2) + 0
              h = substr(iso, 12, 2) + 0; mi = substr(iso, 15, 2) + 0; se = substr(iso, 18, 2) + 0
              yy = (mo <= 2) ? y - 1 : y
              era = int(yy / 400); yoe = yy - era * 400
              doy = int((153 * (mo + ((mo > 2) ? -3 : 9)) + 2) / 5) + d - 1
              doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
              return sprintf("%.0f", (era * 146097 + doe - 719468) * 86400 + h * 3600 + mi * 60 + se)
            }
            lastval($0, "\"type\":\"") == "assistant" { t = lastval($0, "\"timestamp\":\"") }
            END { if (t != "") printf "%s", epoch(t) }
          ' 2>/dev/null)"
          case "$tx" in
            ""|*[!0-9]*) : ;;
            *) if [ "$tx" -ge 1000000000 ] 2>/dev/null && [ "$tx" -le "$now" ] 2>/dev/null; then first="$tx"; fi ;;
          esac
        fi
      fi
      [ "$heal1" -eq 1 ] && p1="$first"
      [ "$heal4" -eq 1 ] && p4="$first"
      # A CHANGE is a new measurement, stamped now: rate_limits change only when an API response
      # refreshes them. An unchanged reading keeps its stamp (a cancelled request returns no new
      # numbers), and an unknown 0 stays 0 until the reading changes.
      chg="$now"
      if [ "$have" -eq 0 ] || [ "$cur5" != "$prev5" ]; then
        if [ "$have" -eq 0 ]; then ts5="$first"; else ts5="$chg"; fi
      else ts5="$p1"; fi
      if [ "$have" -eq 0 ]; then ts7="$first"
      elif [ "$cur7" != "$prev7" ]; then ts7="$chg"
      else ts7="$p4"; fi
      [ -n "$ts7" ] || ts7="$ts5"   # a corrupt line with no TS7 for an empty 7d pair
      if [ "$have" -eq 0 ] || [ "$cur5" != "$prev5" ] || [ "$cur7" != "$prev7" ] || [ "$ts5" != "$o1" ] || [ "$ts7" != "$o4" ]; then
        rl_tmp="$dir/.telemetry-rl2-$sid.$$.tmp"
        if { printf '%s|%s|%s|%s' "$ts5" "$cur5" "$ts7" "$cur7" > "$rl_tmp"; } 2>/dev/null; then
          mv -f "$rl_tmp" "$rl_final" 2>/dev/null || rm -f "$rl_tmp" 2>/dev/null || true
        fi
      fi
    fi
    ;;
esac

# PHASE 3 pool: every session's change tracker (telemetry-rl2-*) in this CCT_DIR. Same safe
# glob + readable/regular-file filter as the old raw pool: a dir, dangling symlink, or
# unreadable entry matching the glob is SKIPPED, never fatal (awk FATALs on a file it cannot
# open, which would blank the whole segment). The list is CLEARED after the awk so CCT_WRAP
# never inherits these paths as its argv.
# LINEAR: collect the kept paths in one newline-separated string and split it once (rebuilding
# "$@" per file is quadratic in the pool size). Tracker names are sanitized to [A-Za-z0-9_-], so
# only the DIRECTORY could contain a newline; in that unusual case the per-file "$@" build is
# used instead. Globbing is off during the split.
nl='
'
case "$dir" in
  *"$nl"*)
    set -- "$dir"/telemetry-rl2-*
    [ -e "$1" ] || set --
    n=$#
    while [ "$n" -gt 0 ]; do
      f=$1; shift
      [ -f "$f" ] && [ -r "$f" ] && set -- "$@" "$f"
      n=$((n - 1))
    done
    ;;
  *)
    list=""
    for f in "$dir"/telemetry-rl2-*; do
      [ -f "$f" ] && [ -r "$f" ] && list="$list$f$nl"
    done
    set -f; oifs=$IFS; IFS=$nl; set -- $list; IFS=$oifs; set +f
    ;;
esac

# PHASE 3 awk. ctx + model + the per-session FALLBACK usage come from THIS render's payload
# ($tmp, the only awk input file). 5h/7d come from the account-wide picker
# over the tracker pool: for EACH window independently, among tracker entries that HAVE that
# window, whose resets_at is a plausible epoch (>=1e9, <1e11) and within the window horizon
# (5h: <= now+21600 ; 7d: <= now+691200), take the newest boundary and in it the most recently
# measured reading (see consider()). No valid entry (or now invalid) -> fall back to THIS
# session own usage with NO countdown.
# LC_ALL=C makes awk byte-wise (the model-id whitelist strips all high/C1 bytes;
# numbers use a "." decimal regardless of locale). countdown() is UNCHANGED.
seg="$(CCT_OWN_RL="$rl_final" LC_ALL=C awk -v now="$now" -v segs="$segs" '
  function objspan(key,   p, i, n, depth, start, c, off) {
    # Find the first occurrence of the quoted key that IS a key (followed, after JSON whitespace,
    # by a colon), skipping the same text used as a string VALUE (e.g. a session name). Then the
    # value must BE an object: a null, number or string value (e.g. "five_hour": null) returns ""
    # instead of scanning ahead into the NEXT object and reading the fields of a sibling as its
    # own. Whitespace is space, tab and CR (LF never reaches J: awk joins the records without it),
    # so CRLF or pretty-printed payloads parse; up(), resetsat() and modelid() allow the same.
    n = length(J); off = 0
    while (1) {
      p = index(substr(J, off + 1), "\"" key "\"")
      if (p == 0) return ""
      p += off; i = p + length(key) + 2
      while (i <= n && index(" \t\r", substr(J, i, 1)) > 0) i++
      if (i <= n && substr(J, i, 1) == ":") break
      off = p
    }
    i++
    while (i <= n && index(" \t\r", substr(J, i, 1)) > 0) i++
    if (i > n || substr(J, i, 1) != "{") return ""
    start = i; depth = 0
    while (i <= n) {
      c = substr(J, i, 1)
      if (c == "{") depth++
      else if (c == "}") { depth--; if (depth == 0) return substr(J, start + 1, i - start - 1) }
      i++
    }
    return ""
  }
  function up(key,   t) {
    t = objspan(key)
    if (t == "") return ""
    gsub(/\{[^{}]*\}/, "", t)
    if (match(t, /"used_percentage"[ \t\r]*:[ \t\r]*[0-9]+(\.[0-9]+)?/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*:[ \t\r]*/, "", t); return t
  }
  function rnd(v) { if (v == "") return ""; return int(v + 0.5) }
  # The model id STRING from the model object. Unlike every other field this is display text,
  # so it is SANITIZED before it can reach the terminal (strip control chars = defuse
  # ANSI/escape injection; strip spaces and "|" so a weird id cannot break the layout).
  function modelid(   t) {
    t = objspan("model")
    if (t == "") return ""
    if (match(t, /"id"[ \t\r]*:[ \t\r]*"[^"]*"/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*"id"[ \t\r]*:[ \t\r]*"/, "", t); sub(/".*/, "", t)
    gsub(/[^]A-Za-z0-9._[-]/, "", t)   # WHITELIST: only safe display chars survive
    return t
  }
  # Short friendly model token: drop the "claude-" prefix and dot the version (digit-hyphen-
  # digit becomes digit-dot-digit), so claude-opus-4-8[1m] -> opus-4.8[1m]. No lookup table.
  function friendlymodel(   m) {
    m = modelid()
    if (m == "") return ""
    sub(/^claude-/, "", m)
    while (match(m, /[0-9]-[0-9]/)) m = substr(m, 1, RSTART) "." substr(m, RSTART + 2)
    return m
  }
  # Compact "~time-left" from an absolute reset epoch. Two units max; trailing unit shown
  # only when non-zero; "~<1m" under a minute. The "~now" branch (sec <= 0) is DEAD from the
  # picker path - consider() excludes r <= now - kept only as defense in depth; the bar can
  # never render "~now". Omits when now/resets_at missing, resets_at not a plausible epoch
  # (< 1e9), or the gap exceeds maxsec.
  function countdown(rsat, maxsec,   sec, d, h, m) {
    if (rsat == "" || now == "") return ""
    if (rsat + 0 < 1000000000) return ""
    sec = rsat - now
    if (sec > maxsec) return ""
    if (sec <= 0) return "~now"
    if (sec < 60) return "~<1m"
    if (sec < 3600) return "~" int(sec/60) "m"
    if (sec < 86400) { h = int(sec/3600); m = int((sec%3600)/60); return (m == 0) ? ("~" h "h") : ("~" h "h" m "m") }
    d = int(sec/86400); h = int((sec%86400)/3600); return (h == 0) ? ("~" d "d") : ("~" d "d" h "h")
  }
  # Rank one tracker entry into the per-window freshest: (resets_at DESC, then stamp DESC).
  # The newest boundary is the newest window. Within one boundary the most recently MEASURED
  # reading wins (the stamp is its measurement time, see the block comment above), whatever the
  # number is (a quota reset makes the newest reading the LOWER one, and it must win). Usage
  # percentages are never compared. All stamps come from this machine clock, so they order
  # consistently. An exact stamp tie (two readings changing in the same second, or several
  # first sightings of unknown time, all 0) prefers THIS session own reading, else keeps the
  # first entry in glob order: deterministic either way.
  # Guards: value present, resets_at a plausible epoch, reset in the FUTURE and within the window
  # horizon (elapsed, corrupt or far-future readings can never win), and the stamp not in the
  # future (a corrupt tracker or a forward clock jump is dropped).
  function consider(win, ts, u, rsat, mine,   r, t, cap) {
    if (u == "" || rsat == "") return
    r = rsat + 0
    if (r < 1e9 || r >= 1e11) return
    cap = (win == 5) ? 21600 : 691200
    # resets_at must be in the FUTURE and within the window horizon: (now, now+cap]. A reading
    # whose reset already ELAPSED predates the last window reset, so it is stale whatever its
    # stamp (a session re-rendering an ancient payload restamps it); this also keeps a
    # misleading "~now" countdown off the bar.
    if (now != "" && (r <= now || r > now + cap)) return
    t = ts + 0
    if (now != "" && t > now + 60) return
    if (win == 5) { if (!h5 || r > r5 || (r == r5 && (t > t5 || (t == t5 && mine)))) { u5 = u; r5 = r; t5 = t; h5 = 1 }; return }
    if (!h7 || r > r7 || (r == r7 && (t > t7 || (t == t7 && mine)))) { u7 = u; r7 = r; t7 = t; h7 = 1 }
  }
  # Tracker files are single-line "TS5|5U|5R|TS7|7U|7R" with a per-window change TS; parse the
  # FIRST line of each. THIS render payload ($tmp) is JSON, accumulated into J for the
  # per-session values instead. A malformed line (too few fields) yields an empty value or
  # resets_at that consider() rejects.
  # The pool files are read with getline in END, not as awk input files: a tracker deleted
  # between the shell scan and this read (a concurrent prune) then just returns -1 and is
  # skipped, where an input file that cannot be opened is FATAL and would blank the bar.
  # own (this session tracker path) comes through ENVIRON, which unlike -v applies no escape
  # processing, so a CCT_DIR containing a backslash still matches.
  BEGIN { own = ENVIRON["CCT_OWN_RL"]; for (i = 2; i < ARGC; i++) { pool[++np] = ARGV[i]; delete ARGV[i] } }
  { J = J $0 }
  END {
    for (i = 1; i <= np; i++) {
      if ((getline line < pool[i]) > 0) {
        split(line, a, "|"); consider(5, a[1], a[2], a[3], pool[i] == own); consider(7, a[4], a[5], a[6], pool[i] == own)
      }
      close(pool[i])
    }
    ctx = rnd(up("context_window")); f5 = rnd(up("five_hour")); f7 = rnd(up("seven_day"))
    # Cross-session ranked value only when now is known (else the horizon guard is off) - else
    # fall back to THIS session own usage with no countdown.
    ctxseg = (ctx == "") ? "ctx --" : ("ctx " ctx "%")
    if (now != "" && h5) { fivehseg = "5h " rnd(u5) "%"; cd = countdown(r5, 21600); if (cd != "") fivehseg = fivehseg " " cd }
    else if (f5 != "")   { fivehseg = "5h " f5 "%" }
    if (now != "" && h7) { sevendseg = "7d " rnd(u7) "%"; cd = countdown(r7, 691200); if (cd != "") sevendseg = sevendseg " " cd }
    else if (f7 != "")   { sevendseg = "7d " f7 "%" }
    modelseg = friendlymodel()
    # Assemble in the CCT_SEGMENTS order, joining the present segments with " | ".
    k = split(segs, arr, /[ ,]+/)
    out = ""
    for (i = 1; i <= k; i++) {
      p = ""
      if (arr[i] == "ctx") p = ctxseg
      else if (arr[i] == "5h") p = fivehseg
      else if (arr[i] == "7d") p = sevendseg
      else if (arr[i] == "model") p = modelseg
      if (p != "") out = (out == "") ? p : (out " | " p)
    }
    # Never-blank fallback that RESPECTS CCT_SEGMENTS: if nothing assembled (e.g. ctx not
    # requested and the pinned window has nothing to show), emit "<label> --" for the FIRST
    # requested token that is one of ctx/5h/7d - never a "ctx --" the user deliberately
    # excluded. If the list names none of those (e.g. only "model"), emit a bare "--". The
    # shell-level seg="ctx --" below stays ONLY as the defense for a fatally-failed awk that
    # emits no output at all.
    if (out == "") {
      for (i = 1; i <= k; i++) {
        if (arr[i] == "ctx") { out = "ctx --"; break }
        else if (arr[i] == "5h") { out = "5h --"; break }
        else if (arr[i] == "7d") { out = "7d --"; break }
      }
      if (out == "") out = "--"
    }
    printf "%s", out
  }
' "$tmp" "$@" 2>/dev/null)"
[ -n "$seg" ] || seg="ctx --"

# Clear the positional params (the account-wide file pool) so the CCT_WRAP command below,
# run via `eval exec`, does NOT inherit these file paths as its argv ($@ / $1 / $#).
set --

# WRAP mode: PRINT our telemetry segment, then EXEC the wrapped statusline so its bar
# appends on the SAME line ("ctx 66% | 5h 12% | 7d 30% <wrapped bar>"). Printing BEFORE
# exec preserves the no-orphan property: the wrapped command still BECOMES the process
# Claude Code kills (no spawn, no detach, no per-render Node). The segment is emitted
# from a subshell so its bytes are FLUSHED to stdout before exec hands the fd to the
# wrapped command (a plain builtin printf can sit in the shell output buffer that exec
# would discard). That subshell is one cheap, synchronously-reaped fork, like the awk
# calls above - not a lingering process.
#
# We do NOT route through `sh -c "$CCT_WRAP"` (which may FORK and leave an orphan on a
# per-render kill), and we NEVER detach. Do NOT background your statusLine with a
# trailing `&`: a statusLine that backgrounds a helper outliving the front pid leaks it
# on every render-kill - IDENTICALLY under direct use and under this wrapper (exec makes
# the wrapped command BECOME the killed process, so the tree matches direct; the leak is
# the forking statusline's own foot-gun, not the wrapper's). test/loadrepro proves this
# (forking callee run both ways: FDIR == FWRP).
if [ -n "${CCT_WRAP:-}" ] && [ -n "$(printf '%s' "${CCT_WRAP:-}" | tr -d '[:space:]')" ]; then
  ( printf '%s ' "$seg" )
  exec 3< "$tmp"
  rm -f "$tmp"
  # `eval` parses a quoted command string ("'/path/adtention' status"); `exec` replaces
  # THIS shell with it so it becomes the killed process. A missing command exits 127
  # (the segment still printed); we NEVER spawn a fallback.
  eval "exec ${CCT_WRAP} <&3"
  exit 0
fi

# STANDALONE mode (no CCT_WRAP): the telemetry segment IS the whole bar.
rm -f "$tmp"
printf '%s' "$seg"
exit 0
